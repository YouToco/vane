[Unit]
Description=Vane isolated research provider gateway
After=network-online.target docker.service
Wants=network-online.target
Requires=vane-research-gateway.socket

[Service]
Type=simple
User=vane-research-gateway
Group=vane-research-gateway
WorkingDirectory=/opt/vane
EnvironmentFile=/opt/vane/env/research-gateway.env
LoadCredential=gateway_db_url:/etc/vane/credentials/gateway_db_url
# The provider API key is no longer duplicated in deployment state. The
# gateway reads only encrypted LLM envelopes through its restricted DB role;
# this KEK remains the sole out-of-database root of trust.
LoadCredential=credential_vault_active_key
LoadCredential=credential_vault_retired_keys
ExecStart=/opt/vane/current/bin/vane-research-gateway
Restart=on-failure
RestartSec=5
TimeoutStopSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
