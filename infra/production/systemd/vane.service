[Unit]
Description=Vane server (见微)
After=network-online.target docker.service vane-research-gateway.socket
Wants=network-online.target
Requires=vane-research-gateway.socket

[Service]
Type=simple
User=vane
Group=vane
WorkingDirectory=/opt/vane
# Host-local bootstrap token. systemd creates /var/lib/vane owned by vane and
# exports STATE_DIRECTORY to the service; existing installations with an owner
# remove any stale token and never reopen setup mode.
StateDirectory=vane
StateDirectoryMode=0700
# The primary Store is intentionally still on the schema-owner compatibility
# boundary.  The separate research pools keep their restricted runtime roles;
# do not point this unit at server.env until the retained owner readers have
# been removed and the server-runtime Gate is authoritative.
EnvironmentFile=/opt/vane/env/server-owner-compat.env
LoadCredential=native_v3_edit_recovery_db_url:/etc/vane/credentials/native_v3_edit_recovery_db_url
# systemd 247 requires an explicit path. The host provisions root-only empty
# placeholders while Telegram is disabled; enabling it makes both credential
# contents mandatory in config.
LoadCredential=telegram_bot_token:/etc/credstore/telegram_bot_token
LoadCredential=telegram_webhook_secret:/etc/credstore/telegram_webhook_secret
# AES-256 KEK for database-backed provider credentials. The key ID is a
# non-secret VANE_CREDENTIAL_VAULT_ACTIVE_KEY_ID value in server env.
LoadCredential=credential_vault_active_key:/etc/credstore/credential_vault_active_key
LoadCredential=credential_vault_retired_keys:/etc/credstore/credential_vault_retired_keys
ExecStart=/opt/vane/current/bin/vane
Restart=on-failure
RestartSec=5
# A5 关停会依次排空 HTTP、飞书回调、deep-dive、Agent 旁路写、创建恢复器、
# 维护任务与 Temporal worker；A2A 与飞书入口并行排空，Temporal 聚合 worker
# 的多个子 worker 仍可能分别消耗 stop timeout，显式最坏预算约 12m30s，
# 再留 2m30s 给调度、连接池回收与 systemd 开销。
# 不覆盖 systemd 默认 90s 会在安全排空完成前 SIGKILL，破坏本进程的退出协议。
TimeoutStopSec=15min

# 除 systemd 管理的 /var/lib/vane 外，服务文件系统保持只读。
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
