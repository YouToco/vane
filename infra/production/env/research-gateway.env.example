# Copy to /opt/vane/env/research-gateway.env. This file intentionally contains
# no database URL, provider API key, main-server settings, agent keys, or fetch
# keys. gateway_db_url and the credential-vault KEK are loaded by systemd
# credentials instead; encrypted LLM generations come from PostgreSQL.
VANE_GATEWAY_ALLOWED_UID=1001
VANE_CREDENTIAL_VAULT_ACTIVE_KEY_ID=vault-key-1
