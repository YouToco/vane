{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vane.release-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_revision", "control_plane_revision", "deploy_run_id", "build_run_attempt"],
  "properties": {
    "schema_version": {"const": "vane.release-receipt/v1"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "control_plane_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "deploy_run_id": {"type": "string", "pattern": "^[0-9]+$"},
    "build_run_attempt": {"type": "integer", "minimum": 1}
  }
}
