# Copy to /opt/vane/.env on the VPS. NEVER commit the real file.
POSTGRES_PASSWORD=changeme
VANE_DB_URL=postgres://vane:changeme@127.0.0.1:5432/vane?sslmode=disable
VANE_LLM_API_KEY=sk-changeme
# 可选 Agent 独立路由；三项必须同时设置，避免跨供应商复用凭证。
VANE_LLM_AGENT_PROVIDER=
VANE_LLM_AGENT_BASE_URL=
VANE_LLM_AGENT_API_KEY=
VANE_LLM_AGENT_MODEL=deepseek-v4-pro
VANE_LLM_COMPILED_ENDPOINT_GENERATION=1
VANE_LLM_COMPILED_CREDENTIAL_GENERATION=1
# 飞书 App ID/Secret 不走环境变量——由 Dashboard 向导写入 settings 表（设这两个变量无效）。
VANE_FETCH_TIKHUB_API_KEY=
VANE_FETCH_EXA_API_KEY=
VANE_FETCH_COMPILED_EXA_CREDENTIAL_GENERATION=1
VANE_FETCH_COMPILED_TIKHUB_CREDENTIAL_GENERATION=1
# 任务手册 prompt 灰度：false=关闭；true + 非空 ID=仅该任务 canary；
# true + 空 ID + allow_all=true=全量开启（第二把钥匙防漏配 canary 时误放量）。
VANE_PIPELINE_PLAYBOOK_PROMPTS_ENABLED=false
VANE_PIPELINE_PLAYBOOK_PROMPT_CANARY_SCHEDULE_ID=
VANE_PIPELINE_PLAYBOOK_PROMPTS_ALLOW_ALL=false
# C1b immutable run snapshot：默认暗发布，先只填一个任务 ID。
VANE_PIPELINE_COMPILED_RUNTIME_ENABLED=false
VANE_PIPELINE_COMPILED_RUNTIME_CANARY_SCHEDULE_ID=
VANE_PIPELINE_COMPILED_RUNTIME_ALLOW_ALL=false
# P1-B durable RunOutcome lifecycle; nested inside compiled runtime.
VANE_PIPELINE_RUN_OUTCOME_ENABLED=false
VANE_PIPELINE_RUN_OUTCOME_CANARY_SCHEDULE_ID=
VANE_PIPELINE_RUN_OUTCOME_ALLOW_ALL=false
# P1-C canonical Brief writer; nested inside RunOutcome.
VANE_PIPELINE_CANONICAL_BRIEF_ENABLED=false
VANE_PIPELINE_CANONICAL_BRIEF_CANARY_SCHEDULE_ID=
VANE_PIPELINE_CANONICAL_BRIEF_ALLOW_ALL=false
# Durable push settlement：默认完全关闭；仅允许一个已进入 compiled runtime
# rollout 的精确任务。无 allow-all 开关，留空即 dark。
VANE_PIPELINE_PUSH_EFFECT_CANARY_SCHEDULE_ID=
# Observation policy rollout：shadow 仅对一个精确任务记录新判定；authority 必须与
# shadow 使用同一 schedule ID。authority 留空=仅 shadow；两者都留空=完全关闭。
VANE_PIPELINE_OBSERVATION_SHADOW_CANARY_SCHEDULE_ID=
VANE_PIPELINE_OBSERVATION_AUTHORITY_CANARY_SCHEDULE_ID=
# Dashboard 登录密码。公网可达，请用 20+ 位随机强密码（无爆破防护会依赖它的强度）。
VANE_DASHBOARD_PASSWORD=changeme
# A2A server（默认关闭；开启后 Bearer token 保护 /a2a，token 存 my-credentials）
VANE_A2A_ENABLED=false
VANE_A2A_TOKEN=
