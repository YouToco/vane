# Copy to /opt/vane/env/research-gateway.env. This file intentionally contains
# no database URL, API key, main-server settings, agent keys, or fetch keys.
# gateway_db_url and llm_api_key_gen1 are loaded by systemd credentials instead.
VANE_GATEWAY_ALLOWED_UID=1001
VANE_GATEWAY_LLM_ROUTES_JSON='[{"provider":"deepseek","endpoint_id":"deepseek-compatible-primary","endpoint_generation":1,"credential_id":"llm-primary","credential_generation":1,"base_url":"https://api.deepseek.com/v1"}]'
