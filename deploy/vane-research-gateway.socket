[Unit]
Description=Vane isolated research provider gateway socket
Before=vane-research-gateway.service vane.service

[Socket]
ListenStream=/run/vane-research-gateway/gateway.sock
SocketUser=vane-research-gateway
SocketGroup=vane
SocketMode=0660
# systemd creates the parent directory as root:root. It must be traversable by
# the unprivileged vane client, but need not be listable; access to the endpoint
# itself remains limited by SocketGroup=vane and SocketMode=0660.
DirectoryMode=0711
RemoveOnStop=yes
Accept=no

[Install]
WantedBy=sockets.target
