# 后端 API 永久入口
api.vane.zhuoqidev.com {
	reverse_proxy localhost:8080
}

# 主站：Dashboard SPA 静态托管 + /api 反代到本机 vane 进程。
# /srv/vane-web 由 compose 卷映射到宿主机 /opt/vane/web（vane-web CI 部署产物落这里）。
# try_files 回落 index.html 是 SPA 刷新/直达路由不 404 的关键。
vane.zhuoqidev.com {
	handle /api/* {
		reverse_proxy localhost:8080
	}
	# A2A agent card 发现端点走后端（a2a-contract §11 PR-infra；拍板：card 放主域）。
	# Caddy 的 handle 按最长路径前缀匹配，不受声明顺序影响；A2A 未启用时后端对该路径 404。
	handle /.well-known/* {
		reverse_proxy localhost:8080
	}
	handle {
		root * /srv/vane-web
		try_files {path} /index.html
		file_server
	}
}
